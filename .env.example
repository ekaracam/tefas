# Copy to .env and adjust. All values are optional; defaults are shown.

# Where the SQLite database lives (relative paths resolve against the project root).
TEFAS_DB_PATH=data/tefas.db

# Comma separated fund types to track. YAT = yatirim fonlari, EMK = emeklilik, BYF = borsa yatirim.
TEFAS_FUND_TYPES=YAT

# How far back the initial backfill reaches. TEFAS itself rejects a start date
# older than 5 years, so values above 5 are clamped by the API.
TEFAS_HISTORY_YEARS=5

# Politeness: minimum gap between two TEFAS requests.
TEFAS_REQUEST_DELAY_MS=3000

# Retry behaviour for a single failed chunk.
TEFAS_MAX_RETRIES=5
TEFAS_RETRY_BASE_MS=10000
TEFAS_THROTTLE_COOLDOWN_MS=60000
TEFAS_TIMEOUT_MS=180000

# Page size sent as bitSira. A full month is ~45k rows, so this fetches a month at once.
TEFAS_PAGE_SIZE=60000

TEFAS_LOG_DIR=logs

# Optional. The API does not currently require an Authorization header.
# Set this only if TEFAS starts requiring a bearer token.
TEFAS_API_TOKEN=
